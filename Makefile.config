# ---------------------------------------------------------------------------
# Toolchain locations.
#
# JAGPATH points at the Jaguar SDK tree (rmvlib + jlibc + mac/aln binaries).
# When running inside the Jaguar SDK Docker image it is preset to /opt/jagsdk.
# Native installs typically use $HOME/Jaguar (the BitJag scripts default).
# ---------------------------------------------------------------------------
JAGPATH		?= $(HOME)/Jaguar

MADMAC		= $(JAGPATH)/bin/mac
ALN		= $(JAGPATH)/bin/aln
CC		= m68k-atari-mint-gcc
LIB		= $(JAGPATH)/lib/lib
INCL		= -I$(JAGPATH)/lib/include
JCP		?= jcp
VJ		?= virtualjaguar

ALNFLAGSRAM	= -a 4000 x x -rq -v -w -y $(LIB)
ALNFLAGSROM	= -a 802000 x 4000 -rq -y $(LIB)

# ---------------------------------------------------------------------------
# Build flavour: DEBUG=0 (default, optimised release) or DEBUG=1 (no opt,
# debug symbols, NDEBUG dropped). Debug builds get a `-debug` suffix on the
# output project name so they coexist with release builds in the same tree.
# ---------------------------------------------------------------------------
DEBUG		?= 0

ifeq ($(DEBUG),1)
CFLAGS		= -mc68000 -Wall -O0 -g -msoft-float -DDEBUG $(INCL)
MACFLAGS	= -fb -v
BUILD_SUFFIX	= -debug
else
CFLAGS		= -mc68000 -Wall -fomit-frame-pointer -O2 -msoft-float -funroll-loops -DNDEBUG $(INCL)
MACFLAGS	= -fb -v
BUILD_SUFFIX	=
endif

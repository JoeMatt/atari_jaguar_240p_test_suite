# ---------------------------------------------------------------------------
# Docker wrappers for the Jaguar SDK image.
#
# These let macOS users (and anyone without a local crossmint install) build
# the ROM with nothing but Docker on their machine. The same image is used in
# CI, so what builds locally builds in CI and vice versa.
#
# All wrapper targets are prefixed with `docker-` to avoid colliding with the
# native build targets defined in Makefile.example (which are themselves used
# inside the container).
#
#   make sdk-pull         -- pull the prebuilt SDK image from GHCR
#   make sdk-build        -- build the SDK image locally from docker/Dockerfile
#   make sdk-shell        -- open an interactive shell in the SDK container
#   make docker-build     -- release build (.cof + .bin) inside the container
#   make docker-debug     -- debug build (.cof + .bin, -debug suffix)
#   make docker-rom       -- release .rom (with cart header) inside the container
#   make docker-rom-debug -- debug   .rom inside the container
#   make docker-all       -- both release and debug ROMs in one invocation
#   make in-docker CMD=.. -- generic escape hatch
#   make native-build     -- build directly on the host (assumes SDK installed)
# ---------------------------------------------------------------------------

# Image coordinates. The default points at this fork's GHCR namespace.
# Override on the command line if you've published your own image:
#   make SDK_IMAGE=ghcr.io/myname/jaguar-sdk:dev sdk-pull docker-build
SDK_OWNER	?= joematt
SDK_IMAGE	?= ghcr.io/$(SDK_OWNER)/jaguar-sdk:latest

DOCKER		?= docker
DOCKER_PLATFORM	?= linux/amd64

# Mount the repo at /work and run as the host user so generated files are not
# owned by root. `--init` ensures Ctrl-C cleanly tears down the build.
DOCKER_RUN	= $(DOCKER) run --rm --init \
		--platform $(DOCKER_PLATFORM) \
		-u $(shell id -u):$(shell id -g) \
		-v "$(CURDIR)":/work \
		-w /work \
		$(SDK_IMAGE)

DOCKER_RUN_TTY	= $(DOCKER) run --rm -it --init \
		--platform $(DOCKER_PLATFORM) \
		-u $(shell id -u):$(shell id -g) \
		-v "$(CURDIR)":/work \
		-w /work \
		$(SDK_IMAGE)

.PHONY: sdk-pull sdk-build sdk-shell \
        docker-build docker-debug docker-rom docker-rom-debug docker-all \
        native-build in-docker help help-toolchain

sdk-pull:
	$(DOCKER) pull $(SDK_IMAGE)

sdk-build:
	$(DOCKER) build --platform $(DOCKER_PLATFORM) -t $(SDK_IMAGE) -f docker/Dockerfile docker

sdk-shell:
	$(DOCKER_RUN_TTY) bash

CMD ?= make
in-docker:
	$(DOCKER_RUN) sh -c '$(CMD)'

docker-build:
	$(DOCKER_RUN) sh -c 'make clean && make'

docker-debug:
	$(DOCKER_RUN) sh -c 'make clean && make DEBUG=1'

docker-rom:
	$(DOCKER_RUN) sh -c 'make clean && make && make rom'

docker-rom-debug:
	$(DOCKER_RUN) sh -c 'make clean && make DEBUG=1 && make DEBUG=1 rom'

docker-all:
	$(DOCKER_RUN) sh -c '\
		make clean && make && make rom && \
		make clean && make DEBUG=1 && make DEBUG=1 rom'

# For users who already have crossmint + rmvlib installed natively (Linux,
# or macOS with the Homebrew tap, etc) and don't want Docker overhead.
native-build:
	$(MAKE) clean
	$(MAKE) all
	$(MAKE) rom

# ---------------------------------------------------------------------------
# Self-documenting target list. `make help` prints categorised targets so
# users (and shell completion previews) can discover what's available.
# Keep the column layout tab-friendly so it renders the same in any shell.
# ---------------------------------------------------------------------------
help:
	@printf 'Atari Jaguar 240p Test Suite -- make targets\n\n'
	@printf 'Native build (needs crossmint + rmvlib in $$JAGPATH=%s):\n' '$(JAGPATH)'
	@printf '  %-22s %s\n' 'all'              'build .cof + .bin (default when toolchain found)'
	@printf '  %-22s %s\n' 'rom'              'build .rom with fastboot cart header'
	@printf '  %-22s %s\n' 'native-build'     'clean + all + rom'
	@printf '  %-22s %s\n' 'dist'             'tar.gz of source + binaries'
	@printf '  %-22s %s\n' 'clean'            'remove build artefacts'
	@printf '\n'
	@printf 'Docker build (needs only docker; pulls ghcr.io image):\n'
	@printf '  %-22s %s\n' 'docker-build'     'release .cof + .bin in SDK container'
	@printf '  %-22s %s\n' 'docker-rom'       'release .rom in SDK container'
	@printf '  %-22s %s\n' 'docker-debug'     'debug .cof + .bin (-O0 -g, -debug suffix)'
	@printf '  %-22s %s\n' 'docker-rom-debug' 'debug .rom'
	@printf '  %-22s %s\n' 'docker-all'       'release + debug ROMs in one invocation'
	@printf '  %-22s %s\n' 'sdk-pull'         'pull SDK_IMAGE=$(SDK_IMAGE) from registry'
	@printf '  %-22s %s\n' 'sdk-build'        'build SDK image locally from docker/Dockerfile'
	@printf '  %-22s %s\n' 'sdk-shell'        'open an interactive shell in the SDK container'
	@printf '  %-22s %s\n' 'in-docker CMD=..' 'run an arbitrary command inside the SDK container'
	@printf '\n'
	@printf 'Hardware / emulator helpers (need the matching tool on PATH):\n'
	@printf '  %-22s %s\n' 'skunkram'         'upload .cof to Skunkboard (jcp)'
	@printf '  %-22s %s\n' 'skunkrom'         'flash .rom to Skunkboard (jcp -f)'
	@printf '  %-22s %s\n' 'vjram / vjrom'    'launch in Virtual Jaguar'
	@printf '  %-22s %s\n' 'bjl'              'send .bin via BJL (lo -8)'
	@printf '  %-22s %s\n' 'alpine / debug'   'launch under Alpine debugger / WDB'
	@printf '\n'
	@printf 'Useful variables:\n'
	@printf '  %-22s %s\n' 'DEBUG=0|1'        'release (default) vs debug build'
	@printf '  %-22s %s\n' 'JAGPATH=PATH'     'Jaguar SDK install root for native builds'
	@printf '  %-22s %s\n' 'SDK_IMAGE=ref'    'override the docker image (default $(SDK_IMAGE))'
	@printf '  %-22s %s\n' 'DOCKER=cmd'       'docker binary (default `docker`)'
	@printf '\n'
	@printf 'Shell completion: `make <TAB>` lists every target above when bash-completion\n'
	@printf 'or zsh compsys is enabled. See README "Shell completion" for setup.\n'

# Friendly fast-fail when neither the native toolchain nor docker is found.
help-toolchain:
	@printf 'Cannot build: neither the native Jaguar toolchain nor Docker were found.\n\n'
	@printf 'Pick one of:\n'
	@printf '  * Install Docker (https://docs.docker.com/get-docker/) and re-run `make`.\n'
	@printf '  * Install the m68k-atari-mint cross toolchain + rmvlib and set JAGPATH.\n'
	@printf '    (BitJag scripts: https://github.com/BitJag/ubuntu-rmvlib-install-scripts)\n\n'
	@printf 'Then run `make help` for the full target list.\n'
	@exit 1
